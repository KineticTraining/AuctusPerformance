# Stripe payments (add STRIPE_SECRET_KEY in environment secrets; optional price IDs & webhook secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_UNLIMITED_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_MACRO_BLUEPRINT=
STRIPE_PRICE_ID_NUTRITION_COACHING=
STRIPE_PRICE_ID_PROGRAM_8WEEK=
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional Supabase configuration (falls back to in-memory mock data when unset)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin Studio access key (configure ADMIN_ACCESS_KEY or VITE_ADMIN_KEY in environment secrets)
ADMIN_ACCESS_KEY=
VITE_ADMIN_KEY=

# Optional AI Gateway key (falls back to technique-database coaching review when unset)
LOVABLE_API_KEY=

# Google OAuth 2.0 Sign-In (register <YOUR_APP_URL>/api/auth/google/callback in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APP_URL=

# Transactional Email Delivery for 6-digit Signup OTP (configure Resend OR SMTP/Nodemailer)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional internal/migration env vars
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
LOVABLE_DB_MIGRATION_URL=
